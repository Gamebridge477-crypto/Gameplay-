# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Random secret string used to sign session cookies in production.
SESSION_SECRET="replace-with-a-long-random-secret"

# DB_PATH: Optional custom file path for the SQLite database (defaults to ./gamebridge.db).
DB_PATH="./gamebridge.db"
